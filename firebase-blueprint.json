{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "2026학년도 장아초 주간업무 및 월중행사 일정",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "일정 고유 식별자"
        },
        "date": {
          "type": "string",
          "description": "행사 및 업무 일자 (YYYY-MM-DD)"
        },
        "target": {
          "type": "string",
          "description": "대상 학년 또는 부서"
        },
        "gradeCategory": {
          "type": "string",
          "description": "행사 또는 외부강사수업 구분"
        },
        "title": {
          "type": "string",
          "description": "행사 및 업무명"
        },
        "details": {
          "type": "string",
          "description": "장소 및 상세 협조사항"
        },
        "person": {
          "type": "string",
          "description": "담당자"
        },
        "createdAt": {
          "type": "string",
          "description": "생성 일시"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정 일시"
        }
      },
      "required": ["id", "date", "target", "title"]
    },
    "DepartmentSetting": {
      "title": "DepartmentSetting",
      "description": "학교 부서 목록 및 환경설정",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "부서 또는 설정 목록"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정 일시"
        }
      }
    },
    "Notice": {
      "title": "Notice",
      "description": "일일업무 중요 안내 및 전달사항",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "전달사항 고유 식별자"
        },
        "author": {
          "type": "string",
          "description": "작성자 또는 담당 부서"
        },
        "title": {
          "type": "string",
          "description": "전달사항 제목"
        },
        "startDate": {
          "type": "string",
          "description": "게시 시작일 (YYYY-MM-DD)"
        },
        "endDate": {
          "type": "string",
          "description": "게시 종료일 (YYYY-MM-DD)"
        },
        "content": {
          "type": "string",
          "description": "전달사항 및 공지 내용"
        },
        "password": {
          "type": "string",
          "description": "수정/삭제용 숫자 4자리 비밀번호"
        },
        "phone": {
          "type": "string",
          "description": "비밀번호 찾기용 등록 휴대폰 번호"
        },
        "createdAt": {
          "type": "string",
          "description": "생성 일시"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정 일시"
        }
      },
      "required": ["id", "author", "title", "startDate", "endDate", "content"]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "Event",
      "description": "장아초등학교 주간 및 월간 행사/업무 컬렉션"
    },
    "/settings/{settingId}": {
      "schema": "DepartmentSetting",
      "description": "학교 부서 및 환경설정 컬렉션"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "일일업무 전체 안내 및 전달사항 컬렉션"
    }
  }
}
