{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "2026학년도 장아초 주간업무 및 월중행사 일정",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "일정 고유 식별자"
        },
        "date": {
          "type": "string",
          "description": "행사 및 업무 일자 (YYYY-MM-DD)"
        },
        "target": {
          "type": "string",
          "description": "대상 학년 또는 부서"
        },
        "gradeCategory": {
          "type": "string",
          "description": "행사 또는 외부강사수업 구분"
        },
        "title": {
          "type": "string",
          "description": "행사 및 업무명"
        },
        "details": {
          "type": "string",
          "description": "장소 및 상세 협조사항"
        },
        "person": {
          "type": "string",
          "description": "담당자"
        },
        "createdAt": {
          "type": "string",
          "description": "생성 일시"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정 일시"
        }
      },
      "required": ["id", "date", "target", "title"]
    },
    "DepartmentSetting": {
      "title": "DepartmentSetting",
      "description": "학교 부서 목록 설정",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "부서 목록"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정 일시"
        }
      }
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "Event",
      "description": "장아초등학교 주간 및 월간 행사/업무 컬렉션"
    },
    "/settings/{settingId}": {
      "schema": "DepartmentSetting",
      "description": "학교 부서 및 환경설정 컬렉션"
    }
  }
}
