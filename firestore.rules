rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'date', 'target', 'title']) &&
             data.keys().hasOnly(['id', 'date', 'target', 'gradeCategory', 'title', 'details', 'person', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.target is string && data.target.size() <= 64 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('gradeCategory' in data) || (data.gradeCategory is string && data.gradeCategory.size() <= 50)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
             (!('person' in data) || (data.person is string && data.person.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isValidId(eventId) && isValidEvent(incoming());
      allow update: if isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isValidId(eventId);
    }
  }
}
